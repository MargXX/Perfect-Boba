rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.status == "queued"
                    && request.resource.data.keys().hasOnly(
                         ["name", "drinker_id", "mode", "size_oz", "recipe", "model", "status", "created_at", "rating"])
                    && request.resource.data.mode in ["ml", "picky"]
                    && request.resource.data.rating == null;
      allow update: if isMachine() || isDev() || rating() || cancelling();
      allow delete: if isDev();
    }

    // Dev edits to the leaderboard (bonus cups, names, hiding, merges).
    match /people/{drinkerId} {
      allow read: if true;
      allow write: if isDev();
    }

    match /machine/state {
      allow read: if true;
      allow write: if isMachine() || isDev();
    }

    // One 1–5 rating per order, after it's been made, with an optional
    // "which way?" answer per knob (-1, 0 or 1).
    function rating() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rating", "feedback"])
          && (!("feedback" in request.resource.data) || request.resource.data.feedback is map)
          && resource.data.status == "done"
          && resource.data.rating == null
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
    }

    // Guests can cancel an order that hasn't started yet.
    function cancelling() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
          && resource.data.status == "queued"
          && request.resource.data.status == "cancelled";
    }

    // Signing in as these emails needs their password, so the email is enough.
    // (The role claim is the older way, set by tools/grant_machine_role.js.)
    function isMachine() {
      return request.auth != null
          && (request.auth.token.email == "machine@bobabot.local" || request.auth.token.role == "machine");
    }

    function isDev() {
      return request.auth != null
          && (request.auth.token.email == "dev@bobabot.local" || request.auth.token.role == "dev");
    }
  }
}
